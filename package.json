  "description": "Autonomous AI-native retention analytics and client-reporting platform for agencies & e-commerce brands.",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "ts-node src/server.ts",
